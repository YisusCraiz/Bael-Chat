<Window x:Class="Bael.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes de BAEL" Width="490" Height="460" MinWidth="390" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#9B2929"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancelar" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
                <Button Content="Guardar" IsDefault="True" Click="Save" Padding="14,6" />
            </StackPanel>
        </StackPanel>
        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="16">
                    <CheckBox x:Name="PinWindow" Content="Mantener BAEL encima de otras ventanas" Margin="0,0,0,12" />
                    <CheckBox x:Name="AllowWalking" Content="Mover la mascota con el chat oculto" Margin="0,0,0,16" />
                    <Label Target="{Binding ElementName=Volume}" Content="Volumen de la voz" Padding="0,0,0,4" />
                    <Slider x:Name="Volume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=Volume, Path=Value, StringFormat={}{0:0}%}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Chat · Gemini">
                <StackPanel Margin="16">
                    <CheckBox x:Name="OnlineChat" Content="Activar Gemini en Tarot y Comedia" Margin="0,0,0,10" />
                    <TextBlock Text="Con Gemini activado, cada mensaje enviado en esos modos se comparte con Google. En caso de error, BAEL ofrece una respuesta local." TextWrapping="Wrap" />
                    <Label Target="{Binding ElementName=GeminiKey}" Content="Clave de Gemini" Padding="0,12,0,4" />
                    <PasswordBox x:Name="GeminiKey" Padding="6" />
                    <Label Target="{Binding ElementName=GeminiModel}" Content="Modelo" Padding="0,12,0,4" />
                    <TextBox x:Name="GeminiModel" Padding="6" />
                    <TextBlock Text="Borra la clave para usar la variable local si está configurada. Deja vacío el modelo para volver al predeterminado." TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Voz · ElevenLabs">
                <StackPanel Margin="16">
                    <Label Target="{Binding ElementName=VoiceKey}" Content="Clave de ElevenLabs" Padding="0,0,0,4" />
                    <PasswordBox x:Name="VoiceKey" Padding="6" />
                    <Label Target="{Binding ElementName=VoiceId}" Content="ID de voz" Padding="0,12,0,4" />
                    <TextBox x:Name="VoiceId" Padding="6" />
                    <TextBlock Text="Los campos vacíos usan las variables locales si están configuradas. ElevenLabs recibe la respuesta solo al pulsar Leer en voz alta." TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
