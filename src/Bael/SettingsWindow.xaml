<Window x:Class="Bael.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAEL-UMAN · Ajustes" Icon="Assets/bael-unicorn.ico" Width="860" Height="680" MinWidth="660" MinHeight="520"
        Background="{DynamicResource UiSurface}" Foreground="{DynamicResource UiText}" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Tu compañero, a tu manera" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource UiText}" />
            <TextBlock Text="Elige una sección y guarda al terminar. Las claves se protegen en tu cuenta de Windows."
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource UiError}"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancelar" Background="{DynamicResource UiPanel}" Foreground="{DynamicResource UiText}" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
                <Button x:Name="SaveSettingsButton" Content="Guardar cambios" IsDefault="True" Click="Save" Padding="14,6" />
            </StackPanel>
        </StackPanel>
        <TabControl TabStripPlacement="Left" Background="{DynamicResource UiPanel}" BorderBrush="{DynamicResource UiBorder}" Padding="10">
            <TabItem Header="Personaje">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <CheckBox x:Name="PinWindow" Content="Mantener BAEL encima de otras ventanas" Margin="0,0,0,12" />
                    <CheckBox x:Name="AllowWalking" Content="Mover la mascota con el chat oculto" Margin="0,0,0,16" />
                    <Border Background="{DynamicResource UiInset}" CornerRadius="12" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="DanceWithAudio" Content="Bailar con el audio de la computadora" />
                            <TextBlock Text="Reacciona al nivel del sonido que sale por el dispositivo predeterminado de Windows, como música, videos o avisos."
                                       TextWrapping="Wrap" Margin="0,7,0,8" />
                            <Label Target="{Binding ElementName=DanceThreshold}" Content="Volumen mínimo para empezar a bailar" Padding="0,0,0,4" />
                            <Slider x:Name="DanceThreshold" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Text="{Binding ElementName=DanceThreshold, Path=Value, StringFormat={}{0:0}%}" />
                            <TextBlock Text="Baja el umbral si la música suena suave. La detección es local y solo consulta el nivel de salida."
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Segundos sin interacción antes del disfraz" Margin="0,0,0,4" />
                    <Slider x:Name="IdleDelay" Minimum="10" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=IdleDelay, Path=Value, StringFormat={}{0:0} s}" Margin="0,0,0,8" />
                    <TextBlock Text="Mensajes en un minuto para quitar el disfraz" />
                    <Slider x:Name="MessageThreshold" Minimum="2" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=MessageThreshold, Path=Value, StringFormat={}{0:0} mensajes}" Margin="0,0,0,8" />
                    <Label Target="{Binding ElementName=Volume}" Content="Volumen de la voz" Padding="0,0,0,4" />
                    <Slider x:Name="Volume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=Volume, Path=Value, StringFormat={}{0:0}%}" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Pantalla y teclas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Apariencia de Ajustes" FontSize="19" FontWeight="SemiBold" />
                        <Label Content="Tema de la ventana de configuración" Target="{Binding ElementName=ThemeChoice}" Padding="0,10,0,5" />
                        <ComboBox x:Name="ThemeChoice" SelectionChanged="ChangeTheme" />
                        <TextBlock Text="Claro u Oscuro. Puedes verlo al instante; se conserva al guardar. Cancelar mantiene tu elección anterior." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,7,0,18" />
                        <TextBlock Text="Un chat ligero sobre tu escritorio" FontSize="19" FontWeight="SemiBold" />
                        <Label Content="Transparencia del fondo del chat" Target="{Binding ElementName=ChatTransparency}" Padding="0,14,0,5" />
                        <Slider x:Name="ChatTransparency" Minimum="0" Maximum="65" TickFrequency="5" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding ElementName=ChatTransparency, Path=Value, StringFormat={}{0:0}% transparente}" />
                        <TextBlock Text="0% es sólido. Más transparencia deja ver el escritorio; el texto conserva su nitidez. Arrastra el encabezado del chat para moverlo y la esquina inferior para cambiar su tamaño." TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Label Content="Tamaño del personaje" Target="{Binding ElementName=MascotScale}" Padding="0,0,0,5" />
                        <Slider x:Name="MascotScale" Minimum="60" Maximum="180" TickFrequency="10" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding ElementName=MascotScale, Path=Value, StringFormat={}{0:0}% del tamaño original}" Margin="0,0,0,8" />
                        <TextBlock Text="El personaje conserva sus proporciones. El tamaño se limita al espacio disponible en pantalla y se recuerda al cerrar." TextWrapping="Wrap" Margin="0,0,0,18" />
                        <TextBlock Text="Atajos globales" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Pulsa en un campo y presiona la combinación deseada. Usa Ctrl o Alt junto a una tecla, o una tecla F (excepto F12). Supr o Retroceso deja el atajo desactivado. Los cambios se aplican al guardar." TextWrapping="Wrap" Margin="0,8,0,12" />
                        <Label Content="Hablar sin abrir el chat" Target="{Binding ElementName=TalkShortcut}" Padding="0,0,0,5" />
                        <TextBox x:Name="TalkShortcut" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" AutomationProperties.Name="Atajo para hablar" />
                        <TextBlock Text="Una pulsación escucha; la siguiente termina la frase. La grabación también termina al hacer una pausa. BAEL muestra el estado y la respuesta en su burbuja." TextWrapping="Wrap" Margin="0,6,0,14" />
                        <Label Content="Activar o desactivar el baile con audio" Target="{Binding ElementName=DanceShortcut}" Padding="0,0,0,5" />
                        <TextBox x:Name="DanceShortcut" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" AutomationProperties.Name="Atajo para activar o desactivar el baile" />
                        <TextBlock Text="Alterna la detección de audio. Al sonar música o cualquier audio del dispositivo predeterminado, BAEL se disfraza de unicornio y baila en cualquier modo. Al parar, recupera su aspecto anterior." TextWrapping="Wrap" Margin="0,6,0,14" />
                        <Label Content="Agrandar el personaje" Target="{Binding ElementName=EnlargeShortcut}" Padding="0,0,0,5" />
                        <TextBox x:Name="EnlargeShortcut" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" AutomationProperties.Name="Atajo para agrandar BAEL" />
                        <Label Content="Reducir el personaje" Target="{Binding ElementName=ShrinkShortcut}" Padding="0,12,0,5" />
                        <TextBox x:Name="ShrinkShortcut" IsReadOnly="True" PreviewKeyDown="CaptureShortcut" AutomationProperties.Name="Atajo para reducir BAEL" />
                        <TextBlock Text="Ctrl + Alt + ↑ agranda y Ctrl + Alt + ↓ reduce en pasos de 10%. Puedes elegir otras combinaciones." TextWrapping="Wrap" Margin="0,7,0,12" />
                        <Button Content="Restaurar atajos predeterminados" Click="ResetShortcuts" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ShortcutStatus" TextWrapping="Wrap" Foreground="{DynamicResource UiError}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Compañía">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="BAEL también puede romper el hielo" FontSize="19" FontWeight="SemiBold" />
                        <CheckBox x:Name="SpontaneousChat" Content="Iniciar conversaciones y compartir curiosidades en modo Libre" Margin="0,16,0,10" />
                        <TextBlock Text="El primer comentario puede aparecer unos 20 segundos después de entrar en Libre. Los siguientes respetan el intervalo. Sale en una burbuja y se guarda en el chat, sin abrirlo automáticamente." TextWrapping="Wrap" Margin="0,0,0,14" />
                        <Label Content="Tiempo mínimo entre comentarios" Target="{Binding ElementName=SpontaneousDelay}" Padding="0,0,0,5" />
                        <Slider x:Name="SpontaneousDelay" Minimum="30" Maximum="900" TickFrequency="30" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding ElementName=SpontaneousDelay, Path=Value, StringFormat={}{0:0} segundos}" Margin="0,0,0,12" />
                        <CheckBox x:Name="SpontaneousVoice" Content="Leer también los comentarios espontáneos con ElevenLabs" Margin="0,0,0,12" />
                        <TextBlock Text="Se pausa mientras escribes a BAEL, grabas, escuchas una respuesta, juegas una aventura, abres Ajustes o el personaje baila. Si limitas Libre a PDF, los comentarios espontáneos se desactivan para respetar ese límite." TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="Con IA en línea activa, usa la personalidad e indicaciones del modo Libre y consume cuota de tus APIs. Sin conexión usa un repertorio local de curiosidades, preguntas y ocurrencias ajustadas al tono y humor. La lectura en voz alta también usa cuota de ElevenLabs." TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Memoria">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Continuidad con control" FontSize="19" FontWeight="SemiBold" />
                        <CheckBox x:Name="SaveConversations" Content="Conservar el historial al cerrar BAEL" Margin="0,16,0,8" />
                        <TextBlock Text="Se guardan los últimos 100 mensajes por modo, protegidos con tu cuenta de Windows. Al desactivar esta opción y guardar, el historial deja de conservarse en disco; los mensajes de la sesión siguen visibles mientras BAEL esté abierto." TextWrapping="Wrap" Margin="0,0,0,14" />
                        <CheckBox x:Name="UseConversationContext" Content="Usar el contexto reciente del modo para continuar la conversación" Margin="0,0,0,8" />
                        <TextBlock Text="Si usas IA, se comparten con los proveedores que intente BAEL hasta 12 turnos recientes de ese modo. Desactivado: cada consulta se envía sin ese contexto previo." TextWrapping="Wrap" Margin="0,0,0,14" />
                        <CheckBox x:Name="UsePinnedMemories" Content="Usar los recuerdos elegidos y activos de cada modo" Margin="0,0,0,8" />
                        <TextBlock Text="Tú escribes las notas que deseas conservar en el gestor. Pueden usarse hasta 6 activas por modo con las APIs de conversación. En modos limitados a PDF no se usan como fuente de respuesta. No se crean recuerdos personales automáticamente." TextWrapping="Wrap" Margin="0,0,0,14" />
                        <Button x:Name="OpenMemoryButton" Content="Abrir historial y recuerdos" HorizontalAlignment="Left" />
                        <TextBlock Text="Los cambios de estas opciones se aplican con Guardar cambios. En el gestor, borrar mensajes o editar recuerdos se aplica al instante. Los recuerdos elegidos se conservan aunque desactives el guardado del historial." TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="DocumentsTab" Header="Documentos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Tu material de consulta" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Añade PDF con texto seleccionable y elige en qué modos serán la única fuente."
                                   TextWrapping="Wrap" Margin="0,8,0,12" />
                        <WrapPanel>
                            <Button x:Name="AddPdfButton" Content="+ Añadir PDF" Click="AddPdf" />
                            <Button x:Name="RemovePdfButton" Content="Quitar de la biblioteca" Click="RemovePdf" />
                        </WrapPanel>
                        <ListBox x:Name="PdfLibraryList" DisplayMemberPath="Label" Height="100" Margin="0,6,0,10" />
                        <TextBlock x:Name="PdfImportStatus" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"
                                   AutomationProperties.LiveSetting="Polite" Margin="0,0,0,14" />
                        <Label Target="{Binding ElementName=DocumentMode}" Content="Modo que quieres configurar" Padding="0,0,0,4" />
                        <ComboBox x:Name="DocumentMode" SelectionChanged="ChangeDocumentMode" />
                        <CheckBox x:Name="LimitToPdf" Content="Limitar este modo solo a sus PDF seleccionados" Margin="0,14,0,8" />
                        <CheckBox x:Name="AssistPdf" Content="Permitir explicaciones con IA usando fragmentos de estos PDF" Margin="0,4,0,8" />
                        <TextBlock Text="Esta opción es independiente para cada modo y requiere Usar IA en línea. Envía tu pregunta y hasta seis fragmentos de los PDF asignados a los proveedores que intente BAEL. No incluye recuerdos ni historial. Si falla o devuelve citas no válidas, se mantienen los pasajes locales." TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="Desactivado el límite: conversación libre. Activado: busca solo en el material seleccionado, con archivo y página. El resumen local es extractivo y el repaso permite completar palabras del texto. Si no encuentra respaldo, lo indica."
                                   TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="PDF permitidos para este modo" FontWeight="SemiBold" />
                        <TextBlock Text="Selecciona varios con Ctrl + clic. Cada modo puede usar archivos distintos."
                                   TextWrapping="Wrap" Margin="0,5,0,5" Foreground="{DynamicResource UiMuted}" />
                        <ListBox x:Name="ModePdfList" DisplayMemberPath="Label" SelectionMode="Multiple" Height="125" />
                        <TextBlock Text="Los archivos se copian a tu biblioteca local al guardar. El modo limitado funciona sin API y busca por términos del documento. Los PDF escaneados necesitan OCR."
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Personalidades">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Una forma de hablar para cada modo" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Elige el modo que quieres personalizar. Los cambios se aplican al guardar."
                                   TextWrapping="Wrap" Margin="0,8,0,12" />
                        <Label Target="{Binding ElementName=PersonalityMode}" Content="Modo" Padding="0,0,0,4" />
                        <ComboBox x:Name="PersonalityMode" SelectionChanged="ChangePersonalityMode" />
                        <Label Target="{Binding ElementName=PersonalityTone}" Content="Carácter" Padding="0,12,0,4" />
                        <ComboBox x:Name="PersonalityTone" />
                        <Label Target="{Binding ElementName=HumorLevel}" Content="Cantidad de humor" Padding="0,12,0,4" />
                        <Slider x:Name="HumorLevel" Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding ElementName=HumorLevel, Path=Value, StringFormat={}{0:0} / 3 · 0 sin bromas · 3 muy bromista}" />
                        <Label Target="{Binding ElementName=PersonalityDetail}" Content="Extensión de las respuestas" Padding="0,12,0,4" />
                        <ComboBox x:Name="PersonalityDetail" />
                        <Label Target="{Binding ElementName=PersonalityAddress}" Content="Cómo quieres que te llame" Padding="0,12,0,4" />
                        <TextBox x:Name="PersonalityAddress" MaxLength="40" />
                        <Label Target="{Binding ElementName=PersonalityInstructions}" Content="Preferencias para expresarse" Padding="0,12,0,4" />
                        <TextBox x:Name="PersonalityInstructions" MaxLength="1200" AcceptsReturn="True" Height="76"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Por ejemplo: usa analogías de anime, evita emojis y explica con palabras sencillas. Estas indicaciones libres se usan con las APIs de chat."
                                   TextWrapping="Wrap" Margin="0,6,0,8" />
                        <WrapPanel>
                            <Button Content="Ver ejemplo local" Click="PreviewPersonality" />
                            <Button Content="Restaurar este modo" Click="ResetPersonality" />
                        </WrapPanel>
                        <Border Background="{DynamicResource UiInset}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                            <TextBlock x:Name="PersonalityPreview" TextWrapping="Wrap"
                                       Text="El ejemplo local muestra carácter, humor y trato. La IA adapta también tus indicaciones libres." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Chat y APIs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Modelos de conversación" FontSize="19" FontWeight="SemiBold" />
                        <CheckBox x:Name="OnlineChat" Content="Usar IA en línea" Margin="0,12,0,8" />
                        <CheckBox x:Name="AutoFallback" Content="Cambiar automáticamente si una API se agota o falla"
                                  Margin="0,0,0,10" />
                        <TextBlock Text="BAEL intenta la lista de arriba hacia abajo y conserva el contexto reciente. El mensaje y ese contexto se comparten con los proveedores que intente."
                                   TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="Orden de preferencia" FontWeight="SemiBold" />
                        <ListBox x:Name="ProfileList" DisplayMemberPath="Label" Height="96"
                                 SelectionChanged="SelectProfile" Margin="0,6,0,4" />
                        <WrapPanel>
                            <Button Content="+ Añadir API" Click="AddProfile" />
                            <Button Content="Quitar" Click="RemoveProfile" />
                            <Button Content="Subir ↑" Click="MoveUp" />
                            <Button Content="Bajar ↓" Click="MoveDown" />
                        </WrapPanel>
                        <Border Background="{DynamicResource UiInset}" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                            <StackPanel x:Name="ProfileEditor">
                                <CheckBox x:Name="ProfileEnabled" Content="Usar esta conexión" Margin="0,0,0,10" />
                                <Label Target="{Binding ElementName=Provider}" Content="Proveedor" Padding="0,0,0,4" />
                                <ComboBox x:Name="Provider" DisplayMemberPath="Name" SelectedValuePath="Name"
                                          SelectionChanged="ChangeProvider" />
                                <TextBlock x:Name="ProviderHelp" TextWrapping="Wrap" Margin="0,10,0,6" />
                                <WrapPanel>
                                    <Button Content="Obtener clave ↗" Click="OpenKeyPage" />
                                    <Button Content="Ver plan y límites ↗" Click="OpenProviderDocs" />
                                </WrapPanel>
                                <Label Target="{Binding ElementName=ProfileModel}" Content="ID del modelo" Padding="0,10,0,4" />
                                <ComboBox x:Name="ProfileModel" IsEditable="True" ToolTip="Selecciona un modelo o escribe otro ID válido para tu cuenta" />
                                <Button x:Name="TestChatButton" Content="Probar conexión del modelo" Click="TestChatConnection" HorizontalAlignment="Left" Margin="0,10,0,3"/>
                                <TextBlock x:Name="ChatTestStatus" Text="La prueba envía solo un saludo breve y puede consumir cuota. No envía tu historial ni PDF." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                <Label Target="{Binding ElementName=ProfileKey}" Content="Clave API" Padding="0,10,0,4" />
                                <PasswordBox x:Name="ProfileKey" />
                                <TextBlock Text="Si dejas la clave vacía, BAEL usa la variable de entorno de ese proveedor cuando existe."
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="El acceso gratuito, el precio y las cuotas dependen del proveedor, modelo y cuenta. Revisa el plan antes de usarlo; activar facturación o elegir un modelo de pago puede generar cobros. Si todas fallan, BAEL responde con una guía local."
                                   TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource UiMuted}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Voz y audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="Lectura y dispositivos" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Label Target="{Binding ElementName=VoiceKey}" Content="Clave de ElevenLabs" Padding="0,0,0,4" />
                    <PasswordBox x:Name="VoiceKey" Padding="6" />
                    <Label Target="{Binding ElementName=VoiceId}" Content="ID de voz" Padding="0,12,0,4" />
                    <TextBox x:Name="VoiceId" Padding="6" />
                    <TextBlock Text="Los campos vacíos usan las variables locales si están configuradas. ElevenLabs recibe el texto cuando pruebas la voz o solicitas una lectura, incluidas las respuestas habladas y la compañía con voz si están activadas." TextWrapping="Wrap" Margin="0,10,0,0" />
                    <WrapPanel Margin="0,7,0,0">
                        <Button x:Name="LoadVoicesButton" Content="Cargar voces de mi cuenta" Click="LoadVoices" />
                        <Button x:Name="TestVoiceButton" Content="Probar voz" Click="TestVoice" />
                    </WrapPanel>
                    <ComboBox x:Name="VoiceChoices" DisplayMemberPath="Label" SelectionChanged="ChooseVoice" />
                    <TextBlock x:Name="VoiceTestStatus" TextWrapping="Wrap" Margin="0,8,0,4" Foreground="{DynamicResource UiMuted}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Label Target="{Binding ElementName=VoiceModel}" Content="Modelo para leer respuestas" Padding="0,12,0,4" />
                    <ComboBox x:Name="VoiceModel" IsEditable="True" />
                    <TextBlock Text="Si una voz rechaza un modelo, elige el que admite en ElevenLabs. Probar voz usa una frase corta y muestra el detalle del servicio."
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Label Target="{Binding ElementName=SpeechModel}" Content="Modelo para escuchar (Speech to Text)" Padding="0,12,0,4" />
                    <TextBox x:Name="SpeechModel" />
                    <Label Content="Pausa al terminar una frase" Target="{Binding ElementName=SpeechPause}" Padding="0,12,0,5" />
                    <Slider x:Name="SpeechPause" Minimum="600" Maximum="2200" TickFrequency="100" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=SpeechPause, Path=Value, StringFormat={}{0:0} ms de silencio}" />
                    <Label Content="Nivel mínimo de voz" Target="{Binding ElementName=SpeechThreshold}" Padding="0,10,0,5" />
                    <Slider x:Name="SpeechThreshold" Minimum="0.1" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=SpeechThreshold, Path=Value, StringFormat={}{0:0.0}%}" />
                    <TextBlock Text="Pausa menor: envía antes la frase. Pausa mayor: permite pensar entre palabras. Baja el nivel si tu voz es suave; súbelo si el ruido activa la detección. El micrófono solo se abre al pulsar Hablar o su atajo." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,6,0,10" />
                    <CheckBox x:Name="SpeakVoiceReplies" Content="Responder en voz alta a mis mensajes hablados" Margin="0,12,0,6" />
                    <TextBlock Text="En el chat pulsa Hablar. La grabación del micrófono seleccionado se envía a ElevenLabs para transcribirla y después se consulta el modo actual. La clave necesita acceso a Speech to Text y cuota disponible."
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Label Target="{Binding ElementName=OutputDevice}" Content="Altavoces o audífonos" Padding="0,12,0,4" />
                    <ComboBox x:Name="OutputDevice" DisplayMemberPath="Name" SelectedValuePath="Id" />
                    <Label Target="{Binding ElementName=InputDevice}" Content="Micrófono" Padding="0,12,0,4" />
                    <ComboBox x:Name="InputDevice" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="ChangeInput" />
                    <Button x:Name="MicTest" Content="Probar micrófono" Click="ToggleMicTest"
                            HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,4" />
                    <ProgressBar x:Name="MicLevel" Maximum="1" Height="8" AutomationProperties.Name="Nivel del micrófono" />
                    <TextBlock Text="Probar micrófono solo mide el nivel local. Hablar en el chat graba una frase para transcribirla. Leer en voz alta reproduce la respuesta en la salida elegida."
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
