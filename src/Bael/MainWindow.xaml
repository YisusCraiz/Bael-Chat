<Window x:Class="Bael.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAEL-UMAN · Conversación" Icon="Assets/bael-unicorn.ico"
        Width="600" Height="740" MinWidth="420" MinHeight="440"
        Topmost="True" WindowStartupLocation="Manual">
    <Grid x:Name="Chat" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="BAEL-UMAN" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="ModeLabel" Text="Modo estudiante" Foreground="#776C90" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="Modes" Content="Modo" Click="OpenModes" ToolTip="Cambiar el modo del personaje" />
                <Button Content="Ocultar" Click="HideChat" Background="White" Foreground="#594C76" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ModeDescription" TextWrapping="Wrap" Foreground="#776C90" Margin="0,0,0,6" />
        <WrapPanel x:Name="ActivityButtons" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="18" BorderBrush="#E9E3F2" BorderThickness="1" Padding="8">
            <Grid>
                <TextBlock Text="Escribe tu primera pregunta para empezar."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A809B">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding ElementName=Conversation, Path=Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="Conversation" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,4" />
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="14" Padding="12" Margin="{Binding Margin}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="#665391" Margin="0,0,0,5" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ChatStatus" TextWrapping="Wrap" Foreground="#776C90" Margin="0,0,0,7"
                       AutomationProperties.LiveSetting="Polite" />
            <Grid>
                <TextBox x:Name="Message" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" PreviewKeyDown="MessageKey"
                         AutomationProperties.Name="Escribe tu mensaje" />
                <TextBlock Text="Escribe aquí…  Enter envía · Shift + Enter añade una línea"
                           IsHitTestVisible="False" Foreground="#9D93AD" Margin="12,10,8,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding ElementName=Message, Path=Text}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <DockPanel Margin="0,7,0,0">
                <Button x:Name="SendButton" Content="Enviar ↗" DockPanel.Dock="Right" Click="SendMessage" />
                <WrapPanel>
                    <Button x:Name="TalkButton" Content="🎙 Hablar" Click="Talk"
                            ToolTip="Pulsa para grabar. Termina al hacer una pausa o pulsar de nuevo." />
                    <Button x:Name="ReadAloudButton" Content="Leer en voz alta" IsEnabled="False" Click="ReadAloud"
                            Background="White" Foreground="#594C76" />
                    <Button Content="Copiar respuesta" Click="CopyReply" Background="White" Foreground="#594C76" />
                </WrapPanel>
            </DockPanel>
            <ProgressBar x:Name="TalkLevel" Height="5" Maximum="1" Visibility="Collapsed" Margin="0,6,0,0" />
            <TextBlock x:Name="SpeechStatus" TextWrapping="Wrap" Foreground="#665391" Margin="0,5,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="VoiceStatus" TextWrapping="Wrap" Foreground="#776C90" Margin="0,4,0,0"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
