<Window x:Class="Bael.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAEL" Width="440" MinWidth="360" SizeToContent="Height"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <Button Content="BAEL" Padding="12,8" Click="OpenChat"
                AutomationProperties.HelpText="Un clic abre el chat. Tres clics rápidos abren los modos." />
        <StackPanel x:Name="Chat" Margin="0,12,0,0" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="Modes" DockPanel.Dock="Right" Content="Cambiar modo"
                        Padding="8,4" Click="OpenModes" />
                <TextBlock x:Name="ModeLabel" Text="Modo estudiante"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
            <ListBox x:Name="Conversation" Height="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Enviar" Margin="8,0,0,0"
                        Padding="8,4" Click="SendMessage" IsDefault="True" />
                <TextBox x:Name="Message" Padding="6,4" AutomationProperties.Name="Mensaje" />
            </DockPanel>
            <Button Content="Leer en voz alta" IsEnabled="False" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Padding="8,4" />
        </StackPanel>
    </StackPanel>
</Window>
