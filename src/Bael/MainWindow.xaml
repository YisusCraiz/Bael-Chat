<Window x:Class="Bael.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAEL-UMAN · Conversación" Icon="Assets/bael-unicorn.ico"
        Width="640" Height="740" MinWidth="540" MinHeight="580"
        Topmost="True" WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" PreviewKeyDown="AccessKey">
    <Border x:Name="ChatSurface" CornerRadius="18" BorderBrush="#AAC8B7EE" BorderThickness="1">
    <Grid x:Name="Chat" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
        <Grid Margin="0,0,0,8" MouseLeftButtonDown="DragChat" Background="Transparent" ToolTip="Arrastra aquí para mover el chat">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="BAEL-UMAN" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="ModeLabel" Text="Modo estudiante" Foreground="#776C90" Margin="0,5,0,0" />
            </StackPanel>
            <WrapPanel Grid.Column="1" MaxWidth="340" HorizontalAlignment="Right">
                <Button Content="Funciones" Click="ExplainFunctions" ToolTip="Ver funciones del modo actual" Background="White" Foreground="#594C76" />
                <Button x:Name="MemoryButton" Content="Memoria" Click="ManageMemory" ToolTip="Historial y recuerdos por modo" />
                <Button x:Name="Modes" Content="Modo" Click="OpenModes" ToolTip="Cambiar el modo del personaje" />
                <Button Content="Ajustes" Click="OpenSettings" ToolTip="Configurar BAEL" />
                <Button x:Name="AccessButton" Content="Desbloquear BAEL" Click="ToggleAccess" ToolTip="Acceder a todos los modos · Ctrl + Shift + L con BAEL enfocado" />
                <Button Content="Ocultar" Click="HideChat" Background="White" Foreground="#594C76" />
            </WrapPanel>
        </Grid>
        <TextBlock x:Name="ModeDescription" TextWrapping="Wrap" Foreground="#776C90" Margin="0,0,0,6" />
        <TextBlock x:Name="MemoryStatus" TextWrapping="Wrap" FontSize="11" Foreground="#776C90" Margin="0,0,0,5" />
        <DockPanel Margin="0,0,0,8">
            <Button Content="Subir PDF" Click="OpenDocuments" DockPanel.Dock="Right" ToolTip="Añadir y asignar material al modo actual" />
            <TextBlock x:Name="DocumentStatus" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="#665391" />
        </DockPanel>
        <WrapPanel x:Name="ActivityButtons" />
        </StackPanel>
        <Border Grid.Row="1" Background="Transparent" CornerRadius="18" BorderBrush="#E9E3F2" BorderThickness="1" Padding="8">
            <Grid>
                <TextBlock Text="Escribe tu primera pregunta para empezar."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A809B">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding ElementName=Conversation, Path=Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="Conversation" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,4" />
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="14" Padding="12" Margin="{Binding Margin}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="#665391" Margin="0,0,0,5" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <DockPanel Margin="0,0,0,5">
                <Button x:Name="StopInteractionButton" DockPanel.Dock="Right" Content="Detener" Click="StopInteraction" IsEnabled="False" Padding="10,5" ToolTip="Cancelar escucha, respuesta o lectura" />
                <TextBlock x:Name="ActivityStatus" Text="Listo para conversar" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#665391" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <Expander Header="Tiempos de esta interacción" Margin="0,0,0,6" Foreground="#665391">
                <StackPanel>
                    <TextBlock x:Name="TimingStatus" TextWrapping="Wrap" FontSize="11" Foreground="#776C90" />
                    <Button Content="Copiar tiempos" Click="CopyTimings" HorizontalAlignment="Left" Padding="8,4" ToolTip="Copia únicamente los tiempos, sin mensajes ni claves" />
                    <TextBlock Text="Grabar incluye el tiempo que hablas. Transcribir, IA y Preparar voz muestran sus esperas reales en esta sesión." FontSize="11" TextWrapping="Wrap" Foreground="#776C90" />
                </StackPanel>
            </Expander>
            <TextBlock x:Name="ChatStatus" TextWrapping="Wrap" Foreground="#776C90" Margin="0,0,0,7"
                       AutomationProperties.LiveSetting="Polite" />
            <Grid>
                <TextBox x:Name="Message" Height="76" Background="#FFFFFFFF" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" PreviewKeyDown="MessageKey"
                         AutomationProperties.Name="Escribe tu mensaje" />
                <TextBlock Text="Escribe aquí…  Enter envía · Shift + Enter añade una línea"
                           IsHitTestVisible="False" Foreground="#9D93AD" Margin="12,10,8,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding ElementName=Message, Path=Text}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <DockPanel Margin="0,7,0,0">
                <Button x:Name="SendButton" Content="Enviar ↗" DockPanel.Dock="Right" Click="SendMessage" />
                <WrapPanel>
                    <Button x:Name="TalkButton" Content="🎙 Hablar" Click="Talk"
                            ToolTip="Pulsa para interrumpir mi voz y hablar. Otra pulsación termina la frase." />
                    <Button x:Name="ReadAloudButton" Content="Leer en voz alta" IsEnabled="False" Click="ReadAloud"
                            Background="White" Foreground="#594C76" />
                    <Button Content="Copiar respuesta" Click="CopyReply" Background="White" Foreground="#594C76" />
                </WrapPanel>
            </DockPanel>
            <ProgressBar x:Name="TalkLevel" Height="5" Maximum="1" Visibility="Collapsed" Margin="0,6,0,0" />
            <TextBlock x:Name="SpeechStatus" TextWrapping="Wrap" Foreground="#665391" Margin="0,5,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="VoiceStatus" TextWrapping="Wrap" Foreground="#776C90" Margin="0,4,0,0"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ResizeGrip Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-13,-13" />
    </Grid>
    </Border>
</Window>
