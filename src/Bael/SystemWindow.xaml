<Window x:Class="Bael.SystemWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BAEL · Centro del sistema" Icon="Assets/bael-unicorn.ico" Width="1180" Height="850" MinWidth="940" MinHeight="700" FontSize="14" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource UiPanel}"/><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/></Style>
  <Style x:Key="SessionAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <SolidColorBrush x:Key="ActivityAccent" Color="#7460C8"/><SolidColorBrush x:Key="ActivitySoft" Color="#EEE9FF"/>
  <Style TargetType="TabItem"><Setter Property="MinWidth" Value="178"/><Setter Property="Margin" Value="0,0,12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Background" Value="{DynamicResource UiPanel}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource ActivitySoft}" CornerRadius="10" Width="32" Height="34" VerticalAlignment="Center"><TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource ActivityAccent}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"><ContentPresenter ContentSource="Header"/><TextBlock x:Name="Hint" Text="{TemplateBinding ToolTip}" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ActivityAccent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Hint" Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <Style TargetType="DataGrid"><Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Background" Value="{DynamicResource UiInput}"/><Setter Property="RowBackground" Value="{DynamicResource UiPanel}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource UiInset}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="36"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Background" Value="{DynamicResource UiSurface}"/><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border CornerRadius="20" Padding="14,10" Margin="0,0,0,10"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30285D" Offset="0"/><GradientStop Color="#6751B4" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#20FFFFFF" CornerRadius="40" Width="88" Height="98"><Image x:Name="CoachAvatar" Stretch="Uniform" Margin="6,3" AutomationProperties.Name="BAEL, tu guía del sistema"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="BAEL · CENTRO DEL SISTEMA" FontSize="11" Foreground="#DAD1FC" FontWeight="Bold"/><TextBlock Text="Tu PC, más fácil de entender." FontSize="27" FontWeight="Bold" Foreground="White" Margin="0,4"/><TextBlock x:Name="CoachMessage" Text="Empecemos por conocer tu equipo. Yo te guío paso a paso." Foreground="#F0EBFF" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="Revisar mi equipo →" Click="RefreshHardware" Background="#28FFFFFF" Foreground="White" BorderBrush="#60FFFFFF" Padding="12,10"/><Button x:Name="CancelButton" Content="Detener revisión" Click="CancelWork" IsEnabled="False" Style="{StaticResource SessionAction}" Background="#28FFFFFF" Foreground="White" BorderBrush="#60FFFFFF"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="{DynamicResource UiPanel}" CornerRadius="14" Padding="14" Margin="0,4,0,14">
   <UniformGrid Columns="2">
    <StackPanel Margin="0,0,20,0"><TextBlock x:Name="CpuLabel" Text="CPU · esperando muestra" FontWeight="SemiBold"/><ProgressBar x:Name="CpuBar" Maximum="100" Height="10" Margin="0,8,0,6"/><Canvas x:Name="HistoryCanvas" Height="40" ClipToBounds="True" Background="{DynamicResource UiInset}"><Polyline x:Name="CpuHistory" Stroke="#7460C8" StrokeThickness="2"/></Canvas><TextBlock Text="Uso de CPU · últimas 60 muestras (1 s)" FontSize="10" Foreground="{DynamicResource UiMuted}"/></StackPanel>
    <StackPanel><TextBlock x:Name="RamLabel" Text="RAM · leyendo uso" FontWeight="SemiBold"/><ProgressBar x:Name="RamBar" Maximum="100" Height="10" Margin="0,8,0,6"/><TextBlock x:Name="RamUsage" TextWrapping="Wrap"/><TextBlock Text="Son muestras de uso; no certifican la salud del equipo." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,8,0,0"/></StackPanel>
   </UniformGrid>
  </Border>
  <TabControl x:Name="Tabs" Grid.Row="2" TabStripPlacement="Left" SelectionChanged="SectionChanged" BorderThickness="0" Background="Transparent">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid KeyboardNavigation.TabNavigation="Local"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TabPanel IsItemsHost="True"/></ScrollViewer><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="8,0,0,0"/></Grid></ControlTemplate></TabControl.Template>
   <TabItem Header="Mi equipo" Tag="⌂" ToolTip="Empieza por aquí"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#7460C8"/><SolidColorBrush x:Key="ActivitySoft" Color="#EEE9FF"/></TabItem.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <Border Background="{DynamicResource UiPanel}" CornerRadius="18" Padding="20" Margin="0,0,0,14"><StackPanel>
     <TextBlock Text="TU PUNTO DE PARTIDA" Foreground="{DynamicResource UiAccent}" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="ComputerName" Text="Vamos a conocer tu computadora." FontSize="23" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,8"/>
     <TextBlock x:Name="InventorySummary" Text="Revisa el hardware para ver tus discos, memoria y componentes en un solo lugar." TextWrapping="Wrap"/>
     <TextBlock Text="01 · Revisa   →   02 · Entiende   →   03 · Elige qué hacer" Foreground="{DynamicResource UiAccent}" FontSize="12" Margin="0,12,0,0"/>
     <Expander Header="Ver recomendaciones y límites de la revisión" Margin="0,12,0,0"><TextBlock x:Name="Recommendations" Text="El inventario es local. Puedes buscar archivos y revisar temporales sin esperar la revisión de hardware." TextWrapping="Wrap" Margin="0,10,0,0"/></Expander>
    </StackPanel></Border>
    <TextBlock Text="¿Qué quieres hacer hoy?" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
    <UniformGrid Columns="2" Margin="0,0,0,16">
     <Button Tag="1" Click="GoSection" Style="{StaticResource QuietButton}" Background="#E6F1FF" Foreground="#174B80" HorizontalContentAlignment="Stretch" Margin="0,0,8,8" Padding="16"><StackPanel><TextBlock Text="Conoce tus discos" FontSize="18" FontWeight="Bold"/><TextBlock Text="Consulta los datos de fiabilidad que Windows puede leer." TextWrapping="Wrap" Margin="0,7,0,9"/><TextBlock Text="Ver discos →" FontWeight="SemiBold"/></StackPanel></Button>
     <Button Tag="2" Click="GoSection" Style="{StaticResource QuietButton}" Background="#DCF7F1" Foreground="#145C51" HorizontalContentAlignment="Stretch" Margin="0,0,8,8" Padding="16"><StackPanel><TextBlock Text="Explora tu memoria" FontSize="18" FontWeight="Bold"/><TextBlock Text="Identifica módulos, formato y pistas para una posible ampliación." TextWrapping="Wrap" Margin="0,7,0,9"/><TextBlock Text="Ver memoria RAM →" FontWeight="SemiBold"/></StackPanel></Button>
     <Button Tag="3" Click="GoSection" Style="{StaticResource QuietButton}" Background="#FFF3D8" Foreground="#794B12" HorizontalContentAlignment="Stretch" Margin="0,0,8,8" Padding="16"><StackPanel><TextBlock Text="Encuentra tus archivos" FontSize="18" FontWeight="Bold"/><TextBlock Text="Busca por nombre o localiza los archivos de mayor tamaño." TextWrapping="Wrap" Margin="0,7,0,9"/><TextBlock Text="Buscar archivos →" FontWeight="SemiBold"/></StackPanel></Button>
     <Button Tag="4" Click="GoSection" Style="{StaticResource QuietButton}" Background="#F1E5FF" Foreground="#623790" HorizontalContentAlignment="Stretch" Margin="0,0,8,8" Padding="16"><StackPanel><TextBlock Text="Recupera espacio" FontSize="18" FontWeight="Bold"/><TextBlock Text="Analiza temporales antiguos y decide cuáles quieres eliminar." TextWrapping="Wrap" Margin="0,7,0,9"/><TextBlock Text="Revisar temporales →" FontWeight="SemiBold"/></StackPanel></Button>
    </UniformGrid>
    <TextBlock Text="Espacio en las unidades" FontSize="17" FontWeight="SemiBold"/>
    <ItemsControl x:Name="Volumes"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource UiPanel}" CornerRadius="12" Padding="12" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="10" Margin="0,7,0,7"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="VolumeNotes" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Discos" Tag="▤" ToolTip="Estado y desgaste"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#1767BE"/><SolidColorBrush x:Key="ActivitySoft" Color="#E6F1FF"/></TabItem.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="Conoce tus discos, sin adivinar." FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="Estado, temperatura, desgaste y horas solo aparecen si Windows puede leerlos. N/D no significa disco sano. El desgaste no predice una fecha de fallo; un estado Healthy tampoco garantiza que no vaya a fallar." TextWrapping="Wrap" Margin="0,8,0,10"/>
    <ItemsControl x:Name="DiskCards"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource UiPanel}" CornerRadius="12" Padding="14" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding State}" Foreground="{DynamicResource UiAccent}" FontWeight="SemiBold"/><WrapPanel Margin="0,5,0,6"><TextBlock Text="{Binding Media}" Margin="0,0,14,0"/><TextBlock Text="{Binding Bus}" Margin="0,0,14,0"/><TextBlock Text="{Binding Size}"/></WrapPanel>
     <TextBlock Text="{Binding Operation}"/><TextBlock Text="{Binding TemperatureText, StringFormat='Temperatura: {0}'}"/><TextBlock Text="{Binding WearText, StringFormat='Desgaste: {0}'}"/><TextBlock Text="{Binding HoursText, StringFormat='Encendido: {0}'}"/><TextBlock Text="{Binding ErrorText, StringFormat='Errores no corregidos: {0}'}"/>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="DiskNotes" Text="Pulsa Revisar hardware. Algunos controladores o adaptadores USB no exponen estos datos; también pueden requerir permisos elevados." TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Memoria RAM" Tag="▦" ToolTip="Módulos y ampliación"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#087E6F"/><SolidColorBrush x:Key="ActivitySoft" Color="#DCF7F1"/></TabItem.Resources><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="¿Puedo ampliar mi memoria?" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="RamSummary" Text="Primero revisa el equipo. Aquí aparecerán los módulos que Windows puede identificar." TextWrapping="Wrap" Margin="0,8,0,8"/><Expander Header="Entender las ubicaciones, velocidades y límites"><TextBlock x:Name="RamAdvice" Text="Revisa el hardware para conocer módulos, ubicaciones y capacidad declarada." TextWrapping="Wrap" Margin="0,8,0,0"/></Expander></StackPanel>
    <DataGrid x:Name="RamModules" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
     <DataGridTextColumn Header="Ubicación" Binding="{Binding Slot}" Width="100"/><DataGridTextColumn Header="Capacidad" Binding="{Binding Size}" Width="90"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Formato" Binding="{Binding Format}" Width="90"/><DataGridTextColumn Header="Velocidad reportada" Binding="{Binding Frequency}" Width="290"/><DataGridTextColumn Header="Fabricante" Binding="{Binding Maker}" Width="110"/><DataGridTextColumn Header="Referencia" Binding="{Binding Part}" Width="150"/>
    </DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="Mis archivos" Tag="⌕" ToolTip="Encuentra lo que buscas"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#9A5A08"/><SolidColorBrush x:Key="ActivitySoft" Color="#FFF3D8"/></TabItem.Resources><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="Encuentra ese archivo." FontSize="23" FontWeight="Bold"/><TextBlock Text="1. Elige dónde buscar    2. Escribe parte del nombre    3. Abre su ubicación" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}" Margin="0,8,0,6"/><TextBlock Text="También puedes ver hasta 200 archivos grandes, desde 10 MB. La búsqueda no abre ni modifica tus archivos." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/></StackPanel>
    <DockPanel Grid.Row="1"><Button Content="Elegir carpeta…" Click="PickFolder" DockPanel.Dock="Right"/><ComboBox x:Name="SearchRoot" IsEditable="True" MinWidth="180" ToolTip="Unidad o carpeta que quieres examinar"/></DockPanel>
    <DockPanel Grid.Row="2" Margin="0,8,0,8"><Button Content="Buscar" Click="SearchFiles" DockPanel.Dock="Right"/><Button Content="Ver archivos grandes" Click="FindLarge" DockPanel.Dock="Right"/><TextBox x:Name="SearchName" ToolTip="Parte del nombre, por ejemplo tarea o .pdf" AutomationProperties.Name="Nombre del archivo"/></DockPanel>
    <DataGrid x:Name="FileResults" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="Tamaño" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="Carpeta" Binding="{Binding Folder}" Width="*"/><DataGridTextColumn Header="Modificado (UTC)" Binding="{Binding Modified}" Width="150"/></DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="4" Margin="0,8,0,0"><Button Content="Abrir ubicación" Click="RevealFile" DockPanel.Dock="Right"/><TextBlock x:Name="SearchReport" TextWrapping="Wrap" Text="Límite por recorrido: 30 s o 200.000 elementos. Una búsqueda parcial no representa todo el disco."/></DockPanel>
   </Grid></TabItem>
   <TabItem Header="Liberar espacio" Tag="↻" ToolTip="Revisa y decide"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#087E6F"/><SolidColorBrush x:Key="ActivitySoft" Color="#DCF7F1"/></TabItem.Resources><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="Un poco de espacio, paso a paso." FontSize="23" FontWeight="Bold"/><Border Background="{DynamicResource UiInset}" CornerRadius="12" Padding="12" Margin="0,10,0,8"><TextBlock Text="1 · Analiza temporales   →   2 · Revisa y marca   →   3 · Limpia tu selección" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}"/></Border><TextBlock Text="Solo temporales de tu usuario sin escritura ni acceso en 7 días. Tú eliges qué se elimina definitivamente." TextWrapping="Wrap"/><Expander Header="¿Qué archivos se omiten?" Margin="0,6,0,0"><TextBlock Text="Se omiten archivos en uso, protegidos, recientes, enlaces y carpetas BAEL. No borra documentos, Descargas, Papelera ni archivos de Windows." TextWrapping="Wrap" Margin="0,7,0,0"/></Expander></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8"><Button Content="Analizar temporales" Click="AnalyzeCleanup"/><Button Content="Seleccionar todo" Click="SelectAllCleanup"/><Button Content="Desmarcar todo" Click="ClearCleanup"/></WrapPanel>
    <DataGrid x:Name="CleanFiles" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Resources><Style TargetType="CheckBox"><EventSetter Event="Checked" Handler="CleanupSelectionChanged"/><EventSetter Event="Unchecked" Handler="CleanupSelectionChanged"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridCheckBoxColumn Header="Limpiar" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn IsReadOnly="True" Header="Nombre" Binding="{Binding Name}" Width="200"/><DataGridTextColumn IsReadOnly="True" Header="Tamaño" Binding="{Binding Size}" Width="100"/><DataGridTextColumn IsReadOnly="True" Header="Carpeta temporal" Binding="{Binding Folder}" Width="*"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock x:Name="SelectionSummary" Text="Sin selección · primero analiza los temporales" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="La eliminación es permanente. Revisa los archivos marcados antes de continuar." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,0,0,6"/><DockPanel><Button x:Name="CleanButton" Content="Eliminar seleccionados" Click="CleanSelected" IsEnabled="False" DockPanel.Dock="Right"/><TextBlock x:Name="CleanReport" Text="Primero analiza para revisar qué se puede liberar." TextWrapping="Wrap"/></DockPanel></StackPanel>
   </Grid></TabItem>
   <TabItem Header="Componentes" Tag="⚙" ToolTip="Inventario e incidencias"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#8050BA"/><SolidColorBrush x:Key="ActivitySoft" Color="#F1E5FF"/></TabItem.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="Tu equipo, pieza por pieza." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Esto no es una prueba eléctrica, térmica ni de estabilidad. No confirma que la placa, la fuente, la GPU o la RAM estén físicamente sanas. No modifica BIOS, controladores ni registro." TextWrapping="Wrap" Margin="0,8,0,12"/>
    <ItemsControl x:Name="Parts"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource UiPanel}" Padding="12" CornerRadius="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status, StringFormat='Estado WMI: {0}'}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Dispositivos con incidencias declaradas" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/>
    <ItemsControl x:Name="Issues"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Code, StringFormat='Código del Administrador de dispositivos: {0}'}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="ComponentNotes" Text="Pulsa Revisar hardware. La ausencia de incidencias detectadas no certifica que todo esté óptimo." TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <TextBlock x:Name="WorkStatus" Grid.Row="3" Text="Listo · todo el análisis se realiza en tu PC" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource UiMuted}" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
