<Window x:Class="Bael.EnglishWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BAEL · Aula de inglés" Icon="Assets/bael-unicorn.ico" Width="1160" Height="820" MinWidth="940" MinHeight="640" FontSize="14" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource UiPanel}"/><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/></Style>
  <Style TargetType="TabItem"><Setter Property="MinWidth" Value="155"/><Setter Property="Margin" Value="0,0,10,7"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Background" Value="{DynamicResource UiPanel}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,15"><ContentPresenter ContentSource="Header" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="FinishButton" Content="Terminar frase" Click="FinishRecording" IsEnabled="False"/><Button x:Name="CancelButton" Content="Detener" Click="CancelWork" IsEnabled="False"/></StackPanel>
   <StackPanel><TextBlock Text="Aula de inglés" FontSize="25" FontWeight="Bold"/><TextBlock Text="Aprende a tu ritmo, con una actividad a la vez" Foreground="{DynamicResource UiMuted}" Margin="0,5,0,10"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource UiPanel}" CornerRadius="12" Padding="12" Margin="0,3,0,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Tu nivel" FontSize="11"/><ComboBox x:Name="LevelChoice" SelectionChanged="LevelChanged"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Hoy vamos a practicar" FontSize="11"/><ComboBox x:Name="LessonChoice" DisplayMemberPath="Title" SelectionChanged="LessonChanged"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Escuchar con" FontSize="11"/><ComboBox x:Name="VoiceChoice" SelectionChanged="PreferenceChanged"/></StackPanel>
    <Button x:Name="ContinueButton" Grid.Column="3" Content="Continuar ruta" Click="ContinueRoute" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><TextBlock x:Name="LevelProgressText" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}"/><TextBlock x:Name="LevelHelp" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/></DockPanel>
  <TabControl x:Name="Tabs" Grid.Row="1" TabStripPlacement="Left" BorderThickness="0" Background="Transparent">
   <TabItem Header="Mi ruta"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock x:Name="GoalText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="GrammarTip" Margin="0,12,0,12" TextWrapping="Wrap"/>
    <UniformGrid Columns="2" Margin="0,6,0,10">
     <Button Tag="1" Click="GoPractice" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Margin="0,0,8,8"><StackPanel><TextBlock Text="01 · Escribe y mejora" FontSize="18" FontWeight="Bold"/><TextBlock Text="Redacta unas frases y descubre cómo mejorarlas, con una explicación por corrección." TextWrapping="Wrap" Margin="0,7,0,3"/><TextBlock Text="Abrir escritura →" Foreground="{DynamicResource UiAccent}"/></StackPanel></Button>
     <Button Tag="2" Click="GoPractice" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"><StackPanel><TextBlock Text="02 · Lee conmigo" FontSize="18" FontWeight="Bold"/><TextBlock Text="Escucha el ejemplo, graba tu lectura y revisa qué palabras necesitas volver a practicar." TextWrapping="Wrap" Margin="0,7,0,3"/><TextBlock Text="Practicar lectura →" Foreground="{DynamicResource UiAccent}"/></StackPanel></Button>
     <Button Tag="3" Click="GoPractice" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Margin="0,0,8,0"><StackPanel><TextBlock Text="03 · Escucha y comprende" FontSize="18" FontWeight="Bold"/><TextBlock Text="Escucha 50 palabras y responde tres preguntas. Te explicaré cada respuesta." TextWrapping="Wrap" Margin="0,7,0,3"/><TextBlock Text="Empezar a escuchar →" Foreground="{DynamicResource UiAccent}"/></StackPanel></Button>
     <Button Tag="4" Click="GoPractice" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="04 · Hablemos en inglés" FontSize="18" FontWeight="Bold"/><TextBlock Text="Usa lo aprendido en una situación realista. Puedes escribir o grabar tu respuesta." TextWrapping="Wrap" Margin="0,7,0,3"/><TextBlock Text="Abrir conversación →" Foreground="{DynamicResource UiAccent}"/></StackPanel></Button>
    </UniformGrid>
    <TextBlock x:Name="RouteSummary" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,16,0,10"/>
    <ListBox x:Name="RouteLessons" MinHeight="120"/>
    <TextBlock Text="Elige cualquier nivel para practicar. Las marcas indican actividades realizadas, no una acreditación de nivel ni una evaluación profesional. Continuar ruta te lleva a la siguiente práctica pendiente." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,14,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="01  Escribir"><Grid Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="Escribe. Entiende. Mejora." FontSize="24" FontWeight="Bold"/><TextBlock Text="Primero escribe tus ideas. Después revisaremos los detalles, sin cambiar tu texto por ti." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,6,0,0"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Background="{DynamicResource UiPanel}" CornerRadius="14" Padding="16"><StackPanel>
       <TextBlock Text="1. Tu reto de hoy" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="WritingTaskSpanish" TextWrapping="Wrap" Margin="0,8,0,10"/>
       <Expander Header="Ver la consigna en inglés"><TextBlock x:Name="WritingTask" TextWrapping="Wrap" Margin="0,7,0,4"/></Expander>
       <Expander Header="Necesito una frase de ejemplo" Margin="0,6,0,0"><TextBlock x:Name="WritingExample" TextWrapping="Wrap" FontStyle="Italic" Margin="0,7,0,4"/></Expander>
      </StackPanel></Border>
      <TextBlock Text="Ahora inténtalo tú" FontWeight="SemiBold" Margin="0,14,0,7"/>
      <Grid><TextBox x:Name="WritingEditor" MinHeight="170" MaxHeight="240" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="3000" Language="en-US" SpellCheck.IsEnabled="True" TextChanged="DraftChanged" Padding="12" FontSize="17" AutomationProperties.Name="Escribe tus frases en inglés"/>
       <TextBlock Text="Escribe aquí tus frases en inglés…" IsHitTestVisible="False" Foreground="{DynamicResource UiMuted}" Margin="14,14,10,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=WritingEditor,Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <DockPanel Margin="0,6,0,8"><Button x:Name="UndoCorrection" Content="Deshacer" Click="UndoWriting" IsEnabled="False" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Padding="8,3"/><TextBlock x:Name="WritingCounter" VerticalAlignment="Center" Foreground="{DynamicResource UiMuted}" FontSize="12"/></DockPanel>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="1" Margin="0,10,0,0">
      <Button Content="Revisar mi texto →" Click="ReviewWriting" HorizontalAlignment="Stretch" Padding="14,12" FontWeight="SemiBold"/>
      <Button Content="Revisión más completa con IA" Click="ReviewWritingAi" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Margin="0,7,0,0" ToolTip="Requiere una API activa y envía únicamente este texto para recibir más sugerencias."/>
      <TextBlock Text="Básica: sin conexión. Con IA: comparte este texto con tu proveedor." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,9,0,0"/>
      <TextBlock x:Name="WritingFeedback" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel></Grid>
     <Border Grid.Column="2" Background="{DynamicResource UiPanel}" CornerRadius="14" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="2. Mira cómo mejorarlo" FontSize="17" FontWeight="Bold"/><TextBlock Text="Cada tarjeta te muestra qué cambiar y por qué." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,6,0,7"/></StackPanel>
      <TextBlock x:Name="CorrectionCount" Grid.Row="1" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}" Margin="0,0,0,9"/>
      <Grid Grid.Row="2">
       <StackPanel x:Name="WritingEmpty" VerticalAlignment="Center" Margin="8"><TextBlock x:Name="WritingEmptyTitle" Text="Tu revisión aparecerá aquí" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="WritingEmptyBody" Text="Escribe unas frases y pulsa Revisar mi texto. Tú decides qué sugerencias utilizar." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,10,0,0"/></StackPanel>
       <ListBox x:Name="WritingIssues" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate>
        <Border Background="{DynamicResource UiInset}" CornerRadius="12" Padding="12"><StackPanel>
         <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}" Margin="0,0,0,8"/>
         <TextBlock Text="Escribiste" FontSize="11" Foreground="{DynamicResource UiMuted}"/><TextBlock Text="{Binding Original}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,8"/>
         <TextBlock Text="Puedes usar" FontSize="11" Foreground="{DynamicResource UiMuted}"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Choice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontSize="17" Margin="0,3,0,9"/>
         <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,0,0,9"/>
         <Button Content="Usar esta corrección" Click="ApplyWritingIssue" Tag="{Binding}" Padding="10,8"/>
         <Expander Header="Detalle de la revisión" FontSize="11" Margin="0,6,0,0"><TextBlock Text="{Binding Source}" TextWrapping="Wrap"/></Expander>
        </StackPanel></Border>
       </DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid>
     </Grid></Border>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="02  Leer conmigo"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="Lee conmigo, paso a paso" FontSize="19" FontWeight="SemiBold"/><Border Background="{DynamicResource UiPanel}" CornerRadius="12" Padding="14" Margin="0,10,0,10"><TextBlock x:Name="ReadingPassage" TextWrapping="Wrap" FontSize="17" LineHeight="26"/></Border>
    <WrapPanel><Button Content="1. Escuchar ejemplo" Click="PlayReading"/><Button Content="2. Grabar mi lectura" Click="RecordReading"/><Button Content="3. Ver mis palabras" Click="EvaluateReading"/></WrapPanel>
    <TextBlock Text="La grabación dura hasta 30 segundos. Se envía a ElevenLabs para transcribir en inglés con tu clave. Puedes revisar el texto antes de comparar. Esta actividad compara palabras, no evalúa fonemas, acento ni entonación; una diferencia puede ser del reconocimiento." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,10,0,8"/>
    <TextBlock Text="Lo que BAEL reconoció (puedes corregirlo si no coincide con lo que dijiste)" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,7"/>
    <TextBox x:Name="ReadingInput" Height="100" MaxLength="3000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ReadingChanged" Language="en-US" AutomationProperties.Name="Transcripción o lectura escrita"/>
    <TextBlock x:Name="ReadingScore" Margin="0,12,0,8" FontWeight="Bold" TextWrapping="Wrap"/>
    <ItemsControl x:Name="ReadingWords"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Background}" CornerRadius="6" Padding="7,4" Margin="2" ToolTip="{Binding Detail}"><TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Verde: coincide · rojo: palabra por repasar o no reconocida · amarillo: palabra adicional. Pasa el cursor para ver el detalle." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,10,0,8"/>
    <TextBlock x:Name="ReadingFeedback" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="03  Escuchar"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock x:Name="ListeningTitle" FontSize="19" FontWeight="SemiBold"/>
    <TextBlock Text="Escucha el texto sin verlo y responde. Puedes repetirlo. Si muestras la transcripción, el resultado se guardará como práctica con apoyo de texto." TextWrapping="Wrap" Margin="0,8,0,10"/>
    <WrapPanel><Button Content="1. Escuchar el relato" Click="PlayListening"/><Button Content="Nuevo intento" Click="NewListening"/><CheckBox x:Name="TextSupport" Content="Mostrar texto (práctica asistida)" Checked="SupportChanged" Unchecked="SupportChanged" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
    <TextBlock x:Name="ListeningPassage" Visibility="Collapsed" TextWrapping="Wrap" FontSize="16" Margin="0,12,0,12"/>
    <TextBlock x:Name="ListeningState" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}" FontWeight="SemiBold" Margin="0,10,0,2"/>
    <StackPanel x:Name="QuestionsPanel" Margin="0,12,0,8" IsEnabled="False"/>
    <Button x:Name="GradeListeningButton" Content="2. Revisar mis respuestas" Click="GradeListening" HorizontalAlignment="Left" IsEnabled="False"/>
    <TextBlock x:Name="ListeningFeedback" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="04  Conversar"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="ConversationGoal" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <CheckBox x:Name="CloudConversation" Grid.Row="1" Content="Usar IA para conversar (envía mensajes de este escenario a tus proveedores)" Checked="PreferenceChanged" Unchecked="PreferenceChanged" Margin="0,10,0,10"/>
    <ListBox x:Name="Dialogue" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Bubble}" CornerRadius="14" Padding="13" Margin="{Binding Spacing}"><StackPanel><TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}" Margin="0,0,0,6"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="22"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBox x:Name="ConversationInput" Grid.Row="3" Height="74" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Language="en-US" SpellCheck.IsEnabled="True" TextChanged="DraftChanged" Margin="0,10,0,8" AutomationProperties.Name="Respuesta para conversar en inglés"/>
    <WrapPanel Grid.Row="4"><Button Content="Enviar mi respuesta →" Click="SendConversation"/><Button Content="Responder con mi voz" Click="RecordConversation"/><Button Content="Escuchar BAEL" Click="PlayConversation"/><Button Content="Reiniciar escenario" Click="RestartConversation"/></WrapPanel>
    <TextBlock x:Name="ConversationFeedback" Grid.Row="5" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </Grid></TabItem>
   <TabItem Header="Mi progreso"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
    <TextBlock Text="Historial de intentos, respuestas y comentarios. Se conserva por nivel y tema, separado del historial del chat. Hasta 300 intentos recientes; las marcas de actividades realizadas se conservan." TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ListBox x:Name="History" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="HistoryChanged"/>
    <TextBox x:Name="HistoryDetail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
   </Grid></TabItem>
  </TabControl>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,10,0,0"><ProgressBar x:Name="MicLevel" Maximum="1" Height="4" Visibility="Collapsed"/><TextBlock x:Name="WorkStatus" Text="Listo para practicar" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="SaveStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource UiMuted}"/></StackPanel>
 </Grid>
</Window>
