<Window x:Class="Bael.EnglishWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BAEL · Aula de inglés" Icon="Assets/bael-unicorn.ico" Width="1180" Height="850" MinWidth="900" MinHeight="640" FontSize="14" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource UiPanel}"/><Setter Property="Foreground" Value="{DynamicResource UiAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/></Style>
  <Style x:Key="SessionAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <SolidColorBrush x:Key="ActivityAccent" Color="#7460C8"/><SolidColorBrush x:Key="ActivitySoft" Color="#EEE9FF"/>
  <Style TargetType="TabItem"><Setter Property="MinWidth" Value="178"/><Setter Property="Margin" Value="0,0,12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Background" Value="{DynamicResource UiPanel}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" CornerRadius="13" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource ActivitySoft}" CornerRadius="10" Width="32" Height="34" VerticalAlignment="Center"><TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource ActivityAccent}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"><ContentPresenter ContentSource="Header"/><TextBlock x:Name="Hint" Text="{TemplateBinding ToolTip}" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ActivityAccent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Hint" Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border CornerRadius="20" Padding="14,10" Margin="0,0,0,10"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30285D" Offset="0"/><GradientStop Color="#6751B4" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#20FFFFFF" CornerRadius="40" Width="88" Height="98"><Image x:Name="CoachAvatar" Stretch="Uniform" Margin="6,3" AutomationProperties.Name="BAEL, tu compañero de inglés"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0"><TextBlock Text="BAEL · AULA DE INGLÉS" FontSize="11" Foreground="#DAD1FC" FontWeight="Bold"/><TextBlock Text="Tu inglés, a tu ritmo." FontSize="27" FontWeight="Bold" Foreground="White" Margin="0,4,0,4"/><TextBlock x:Name="CoachMessage" Text="Yo te acompaño. Tú das el siguiente paso." Foreground="#F0EBFF" TextWrapping="Wrap" MaxWidth="570" HorizontalAlignment="Left"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="FinishButton" Style="{StaticResource SessionAction}" Content="Terminar frase" Click="FinishRecording" IsEnabled="False" Background="#28FFFFFF" Foreground="White" BorderBrush="#60FFFFFF" Padding="10,7"/><Button x:Name="CancelButton" Style="{StaticResource SessionAction}" Content="Detener" Click="CancelWork" IsEnabled="False" Background="#28FFFFFF" Foreground="White" BorderBrush="#60FFFFFF" Padding="10,7"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="{DynamicResource UiPanel}" CornerRadius="12" Padding="12" Margin="0,3,0,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Tu nivel" FontSize="11"/><ComboBox x:Name="LevelChoice" SelectionChanged="LevelChanged"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Hoy vamos a practicar" FontSize="11"/><ComboBox x:Name="LessonChoice" DisplayMemberPath="Title" SelectionChanged="LessonChanged"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Escuchar con" FontSize="11"/><ComboBox x:Name="VoiceChoice" SelectionChanged="PreferenceChanged"/></StackPanel>
    <Button x:Name="ContinueButton" Grid.Column="3" Content="Continuar ruta" Click="ContinueRoute" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><Border DockPanel.Dock="Right" Background="{DynamicResource UiInset}" CornerRadius="9" Padding="9,5"><TextBlock x:Name="LevelProgressText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}"/></Border><TextBlock x:Name="LevelHelp" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}"/></DockPanel>
  <TabControl x:Name="Tabs" Grid.Row="1" TabStripPlacement="Left" SelectionChanged="SectionChanged" BorderThickness="0" Background="Transparent">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid KeyboardNavigation.TabNavigation="Local"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TabPanel IsItemsHost="True"/></ScrollViewer><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="8,0,0,0"/></Grid></ControlTemplate></TabControl.Template>
   <TabItem Header="Mi misión" Tag="⌂" ToolTip="Continúa donde ibas"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#7460C8"/><SolidColorBrush x:Key="ActivitySoft" Color="#EEE9FF"/></TabItem.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <Border Background="{DynamicResource UiPanel}" CornerRadius="18" Padding="20" Margin="0,0,0,14"><StackPanel>
     <TextBlock Text="TU MISIÓN DE ESTE TEMA" FontSize="11" Foreground="{DynamicResource UiAccent}" FontWeight="Bold"/><TextBlock x:Name="GoalText" FontSize="23" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,10"/>
     <ItemsControl x:Name="SkillTrail"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Index}" Click="GoPractice" Background="{Binding Background}" Foreground="{Binding Foreground}" BorderThickness="0" Padding="9,6" Margin="0,0,7,7"><TextBlock Text="{Binding Label}"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button x:Name="MissionStart" Content="Empezar mi práctica →" Click="ContinueRoute" HorizontalAlignment="Left" Padding="18,12" Margin="0,8,0,0"/>
     <Expander Header="Una pista antes de empezar" Margin="0,10,0,0"><TextBlock x:Name="GrammarTip" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
    </StackPanel></Border>
    <TextBlock Text="¿Qué quieres practicar?" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
    <UniformGrid Columns="2" Margin="0,6,0,10">
     <Button Tag="1" Click="GoPractice" Style="{StaticResource QuietButton}" Background="#E6F1FF" Foreground="#174B80" BorderBrush="#C6DDF5" HorizontalContentAlignment="Stretch" Margin="0,0,8,8"><StackPanel><TextBlock Text="01 · Escribe y mejora" FontSize="18" FontWeight="Bold"/><TextBlock Text="Redacta unas frases y descubre cómo mejorarlas, con una explicación por corrección." TextWrapping="Wrap" Margin="0,7,0,3"/><TextBlock Text="Abrir escritura →" Foreground="{DynamicResource UiAccent}"/></StackPanel></Button>
     <Button Tag="2" Click="GoPractice" Style="{StaticResource QuietButton}" Background="#DCF7F1" Foreground="#145C51" BorderBrush="#B4E4D8" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"><StackPanel><TextBlock Text="02 · Lee conmigo" FontSize="18" FontWeight="Bold"/><TextBlock Text="Escucha el ejemplo, graba tu lectura y revisa qué palabras necesitas volver a practicar." TextWrapping="Wrap" Margin="0,7,0,3"/><TextBlock Text="Practicar lectura →" Foreground="{DynamicResource UiAccent}"/></StackPanel></Button>
     <Button Tag="3" Click="GoPractice" Style="{StaticResource QuietButton}" Background="#FFF3D8" Foreground="#794B12" BorderBrush="#EED9A8" HorizontalContentAlignment="Stretch" Margin="0,0,8,0"><StackPanel><TextBlock Text="03 · Escucha y comprende" FontSize="18" FontWeight="Bold"/><TextBlock Text="Escucha 50 palabras y responde tres preguntas. Te explicaré cada respuesta." TextWrapping="Wrap" Margin="0,7,0,3"/><TextBlock Text="Empezar a escuchar →" Foreground="{DynamicResource UiAccent}"/></StackPanel></Button>
     <Button Tag="4" Click="GoPractice" Style="{StaticResource QuietButton}" Background="#F1E5FF" Foreground="#623790" BorderBrush="#DFC9F5" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="04 · Hablemos en inglés" FontSize="18" FontWeight="Bold"/><TextBlock Text="Usa lo aprendido en una situación realista. Puedes escribir o grabar tu respuesta." TextWrapping="Wrap" Margin="0,7,0,3"/><TextBlock Text="Abrir conversación →" Foreground="{DynamicResource UiAccent}"/></StackPanel></Button>
    </UniformGrid>
    <Expander Header="Ver mis prácticas y cómo se marca el avance" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="RouteSummary" TextWrapping="Wrap" Margin="0,10,0,8"/><ListBox x:Name="RouteLessons" MinHeight="90"/><TextBlock Text="Las marcas reflejan actividades realizadas, no una acreditación de nivel. Puedes elegir cualquier práctica o seguir la sugerida." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,10,0,0"/></StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Escribir" Tag="Aa" ToolTip="Expresa tus ideas"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#1767BE"/><SolidColorBrush x:Key="ActivitySoft" Color="#E6F1FF"/></TabItem.Resources><Grid Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="Vamos a darle forma a tus ideas." FontSize="24" FontWeight="Bold"/><TextBlock Text="Escribe a tu manera. Yo te mostraré qué puedes mejorar, una frase a la vez." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,6,0,0"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Background="{DynamicResource UiPanel}" CornerRadius="14" Padding="16"><StackPanel>
       <TextBlock Text="Tu pequeño reto de hoy" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="WritingTaskSpanish" TextWrapping="Wrap" Margin="0,8,0,10"/>
       <Expander Header="Ver la consigna en inglés"><TextBlock x:Name="WritingTask" TextWrapping="Wrap" Margin="0,7,0,4"/></Expander>
       <Expander Header="Necesito una frase de ejemplo" Margin="0,6,0,0"><TextBlock x:Name="WritingExample" TextWrapping="Wrap" FontStyle="Italic" Margin="0,7,0,4"/></Expander>
      </StackPanel></Border>
      <TextBlock Text="Ahora inténtalo tú" FontWeight="SemiBold" Margin="0,14,0,7"/>
      <Grid><TextBox x:Name="WritingEditor" MinHeight="170" MaxHeight="240" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="3000" Language="en-US" SpellCheck.IsEnabled="True" TextChanged="DraftChanged" Padding="12" FontSize="17" AutomationProperties.Name="Escribe tus frases en inglés"/>
       <TextBlock Text="Escribe aquí tus frases en inglés…" IsHitTestVisible="False" Foreground="{DynamicResource UiMuted}" Margin="14,14,10,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=WritingEditor,Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <DockPanel Margin="0,6,0,8"><Button x:Name="UndoCorrection" Content="Deshacer" Click="UndoWriting" IsEnabled="False" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Padding="8,3"/><TextBlock x:Name="WritingCounter" VerticalAlignment="Center" Foreground="{DynamicResource UiMuted}" FontSize="12"/></DockPanel>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="1" Margin="0,10,0,0">
      <Button Content="Revisar mis frases →" Click="ReviewWriting" Background="#1767BE" BorderBrush="#1767BE" HorizontalAlignment="Stretch" Padding="14,12" FontWeight="SemiBold"/>
      <Expander Header="Revisión con IA · usa el proveedor de Chat y APIs" Margin="0,9,0,0"><StackPanel><TextBlock Text="La revisión básica es local. Esta opción envía tu texto a la API configurada para buscar más sugerencias." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,7,0,6"/><Button Content="Pedir sugerencias a la IA" Click="ReviewWritingAi" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"/></StackPanel></Expander>
      <TextBlock x:Name="WritingFeedback" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel></Grid>
     <Border Grid.Column="2" Background="{DynamicResource UiPanel}" CornerRadius="14" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Una mejora, bien explicada" FontSize="17" FontWeight="Bold"/><TextBlock Text="Compara, entiende y decide si quieres usarla." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,6,0,7"/></StackPanel>
      <TextBlock x:Name="CorrectionCount" Grid.Row="1" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}" Margin="0,0,0,9"/>
      <Grid Grid.Row="2">
       <StackPanel x:Name="WritingEmpty" VerticalAlignment="Center" Margin="8"><Border Background="#E6F1FF" CornerRadius="25" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,14"><TextBlock x:Name="CoachMiniSymbol" Text="Aa" Foreground="#1767BE" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="WritingEmptyTitle" Text="Tu revisión aparecerá aquí" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="WritingEmptyBody" Text="Escribe unas frases y pulsa Revisar mi texto. Tú decides qué sugerencias utilizar." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,10,0,0"/></StackPanel>
       <ListBox x:Name="WritingIssues" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate>
        <Border Background="{DynamicResource UiInset}" CornerRadius="12" Padding="12"><StackPanel>
         <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}" Margin="0,0,0,8"/>
         <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Escribiste" FontSize="11" Foreground="{DynamicResource UiMuted}"/><Border Background="{DynamicResource UiPanel}" CornerRadius="7" Padding="7" Margin="0,4,0,0"><TextBlock Text="{Binding Original}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></Border></StackPanel>
          <TextBlock Grid.Column="1" Text="→" FontSize="20" Foreground="{DynamicResource UiMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2"><TextBlock Text="Puedes usar" FontSize="11" Foreground="{DynamicResource UiMuted}"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Choice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,4,0,0" MinHeight="34"/></StackPanel>
         </Grid>
         <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,0,0,9"/>
         <Button Content="Sí, usar esta mejora" Click="ApplyWritingIssue" Tag="{Binding}" Background="#1767BE" BorderBrush="#1767BE" Padding="10,8"/>
         <Expander Header="Detalle de la revisión" FontSize="11" Margin="0,6,0,0"><TextBlock Text="{Binding Source}" TextWrapping="Wrap"/></Expander>
        </StackPanel></Border>
       </DataTemplate></ListBox.ItemTemplate></ListBox>
      </Grid>
     </Grid></Border>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="Leer en voz alta" Tag="Ab" ToolTip="Escucha y practica"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#087E6F"/><SolidColorBrush x:Key="ActivitySoft" Color="#DCF7F1"/></TabItem.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="Lee conmigo, paso a paso" FontSize="19" FontWeight="SemiBold"/><Border Background="{DynamicResource UiPanel}" CornerRadius="12" Padding="14" Margin="0,10,0,10"><TextBlock x:Name="ReadingPassage" TextWrapping="Wrap" FontSize="17" LineHeight="26"/></Border>
    <WrapPanel><Button Content="1. Escuchar ejemplo" Click="PlayReading"/><Button Content="2. Grabar mi lectura" Click="RecordReading"/><Button Content="3. Ver mis palabras" Click="EvaluateReading"/></WrapPanel>
    <TextBlock Text="La grabación dura hasta 30 segundos. Se envía a ElevenLabs para transcribir en inglés con tu clave. Puedes revisar el texto antes de comparar. Esta actividad compara palabras, no evalúa fonemas, acento ni entonación; una diferencia puede ser del reconocimiento." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,10,0,8"/>
    <TextBlock Text="Lo que BAEL reconoció (puedes corregirlo si no coincide con lo que dijiste)" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,7"/>
    <TextBox x:Name="ReadingInput" Height="100" MaxLength="3000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ReadingChanged" Language="en-US" AutomationProperties.Name="Transcripción o lectura escrita"/>
    <TextBlock x:Name="ReadingScore" Margin="0,12,0,8" FontWeight="Bold" TextWrapping="Wrap"/>
    <ItemsControl x:Name="ReadingWords"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Background}" CornerRadius="6" Padding="7,4" Margin="2" ToolTip="{Binding Detail}"><TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Verde: coincide · rojo: palabra por repasar o no reconocida · amarillo: palabra adicional. Pasa el cursor para ver el detalle." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,10,0,8"/>
    <TextBlock x:Name="ReadingFeedback" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Escuchar" Tag="♪" ToolTip="Comprende un relato"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#9A5A08"/><SolidColorBrush x:Key="ActivitySoft" Color="#FFF3D8"/></TabItem.Resources><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock x:Name="ListeningTitle" FontSize="19" FontWeight="SemiBold"/>
    <TextBlock Text="Escucha el texto sin verlo y responde. Puedes repetirlo. Si muestras la transcripción, el resultado se guardará como práctica con apoyo de texto." TextWrapping="Wrap" Margin="0,8,0,10"/>
    <WrapPanel><Button Content="1. Escuchar el relato" Click="PlayListening"/><Button Content="Nuevo intento" Click="NewListening"/><CheckBox x:Name="TextSupport" Content="Mostrar texto (práctica asistida)" Checked="SupportChanged" Unchecked="SupportChanged" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
    <TextBlock x:Name="ListeningPassage" Visibility="Collapsed" TextWrapping="Wrap" FontSize="16" Margin="0,12,0,12"/>
    <TextBlock x:Name="ListeningState" TextWrapping="Wrap" Foreground="{DynamicResource UiAccent}" FontWeight="SemiBold" Margin="0,10,0,2"/>
    <StackPanel x:Name="QuestionsPanel" Margin="0,12,0,8" IsEnabled="False"/>
    <Button x:Name="GradeListeningButton" Content="2. Revisar mis respuestas" Click="GradeListening" HorizontalAlignment="Left" IsEnabled="False"/>
    <TextBlock x:Name="ListeningFeedback" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Conversar" Tag="Hi" ToolTip="Aplica lo aprendido"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#8050BA"/><SolidColorBrush x:Key="ActivitySoft" Color="#F1E5FF"/></TabItem.Resources><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="ConversationGoal" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1"><CheckBox x:Name="CloudConversation" Content="Conversar con IA · requiere Chat y APIs activo (sin marcar: escenario local)" Checked="PreferenceChanged" Unchecked="PreferenceChanged" Margin="0,10,0,5"/><CheckBox x:Name="AutoReadConversation" Content="Leer la respuesta automáticamente con la voz seleccionada" Margin="0,0,0,10"/></StackPanel>
    <ListBox x:Name="Dialogue" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Bubble}" CornerRadius="14" Padding="13" Margin="{Binding Spacing}"><StackPanel><TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{DynamicResource UiAccent}" Margin="0,0,0,6"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="22"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBox x:Name="ConversationInput" Grid.Row="3" Height="74" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Language="en-US" SpellCheck.IsEnabled="True" TextChanged="DraftChanged" Margin="0,10,0,8" AutomationProperties.Name="Respuesta para conversar en inglés"/>
    <WrapPanel Grid.Row="4"><Button Content="Enviar mi respuesta →" Click="SendConversation"/><Button Content="Responder con mi voz" Click="RecordConversation"/><Button Content="Escuchar BAEL" Click="PlayConversation"/><Button Content="Reiniciar escenario" Click="RestartConversation"/></WrapPanel>
    <TextBlock x:Name="ConversationFeedback" Grid.Row="5" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </Grid></TabItem>
   <TabItem Header="Mis avances" Tag="✓" ToolTip="Tus intentos guardados"><TabItem.Resources><SolidColorBrush x:Key="ActivityAccent" Color="#7460C8"/><SolidColorBrush x:Key="ActivitySoft" Color="#EEE9FF"/></TabItem.Resources><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
    <TextBlock Text="Historial de intentos, respuestas y comentarios. Se conserva por nivel y tema, separado del historial del chat. Hasta 300 intentos recientes; las marcas de actividades realizadas se conservan." TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ListBox x:Name="History" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="HistoryChanged"/>
    <TextBox x:Name="HistoryDetail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
   </Grid></TabItem>
  </TabControl>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,10,0,0"><ProgressBar x:Name="MicLevel" Maximum="1" Height="4" Visibility="Collapsed"/><DockPanel><Button Content="Ver mis avances" Tag="5" Click="GoPractice" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="8,4"/><TextBlock x:Name="WorkStatus" Text="Listo para practicar" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel><Expander x:Name="StorageDetails" Header="Guardado y privacidad" FontSize="11"><TextBlock x:Name="SaveStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource UiMuted}" Margin="0,5,0,0"/></Expander></StackPanel>

 </Grid>
</Window>
