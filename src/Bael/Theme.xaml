<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="UiSurface" Color="#F5F3FA" />
    <SolidColorBrush x:Key="UiPanel" Color="White" />
    <SolidColorBrush x:Key="UiInset" Color="#F1ECFA" />
    <SolidColorBrush x:Key="UiInput" Color="#FBFAFE" />
    <SolidColorBrush x:Key="UiText" Color="#302847" />
    <SolidColorBrush x:Key="UiMuted" Color="#776C90" />
    <SolidColorBrush x:Key="UiBorder" Color="#DBD5EB" />
    <SolidColorBrush x:Key="UiAccent" Color="#7460C8" />
    <SolidColorBrush x:Key="UiOnAccent" Color="White" />
    <SolidColorBrush x:Key="UiSelected" Color="#E9E3F9" />
    <SolidColorBrush x:Key="UiError" Color="#9B2929" />
    <SolidColorBrush x:Key="UiFocus" Color="#503B91" />
    <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource UiText}" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource UiText}" /></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource UiInput}" /><Setter Property="Foreground" Value="{DynamicResource UiText}" /><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}" /></Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource UiInput}" /><Setter Property="Foreground" Value="{DynamicResource UiText}" />
        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource UiSelected}" /></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource UiSelected}" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource UiText}" />
        <Setter Property="Background" Value="{DynamicResource UiSurface}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource UiAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource UiOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,3,6,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="12" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource UiFocus}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource UiText}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}" />
        <Setter Property="Background" Value="{DynamicResource UiInput}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource UiAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource UiInput}" />
        <Setter Property="Foreground" Value="{DynamicResource UiText}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource UiText}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}" />
        <Setter Property="Background" Value="{DynamicResource UiInput}" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource UiText}" />
        <Setter Property="Margin" Value="0,0,8,6" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab" Background="Transparent" CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="{DynamicResource UiSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource UiFocus}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tab" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
