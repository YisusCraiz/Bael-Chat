<Window x:Class="Bael.DesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAEL-UMAN" Icon="Assets/bael-unicorn.ico" Width="300" Height="300" WindowStyle="None"
        AllowsTransparency="True" Background="{x:Null}" ResizeMode="NoResize"
        ShowInTaskbar="True" Topmost="True" WindowStartupLocation="Manual"
        PreviewKeyDown="WheelKey">
    <Grid>
    <Viewbox Stretch="Uniform">
    <Grid Width="300" Height="300">
        <Image x:Name="Character" Margin="30,30,30,42" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
               MouseRightButtonUp="OpenWheel" MouseLeftButtonDown="BeginDrag" MouseMove="MoveDrag" MouseLeftButtonUp="EndDrag"
               AutomationProperties.Name="Unicornio BAEL. Pulsa para hablar o arrastra para mover."
               ToolTip="Pulsa para hablar. Arrastra para mover. Shift + clic derecho abre los modos y ajustes.">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Facing" ScaleX="1" />
                    <RotateTransform x:Name="BodyTilt" />
                    <TranslateTransform x:Name="BodyBob" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <WrapPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4">
            <Button Content="Ajustes" Click="ShowSettings" Padding="9,5" />
            <Button x:Name="DesktopAccess" Content="Desbloquear" Click="ToggleAccess" Padding="9,5" ToolTip="Todos los modos · Ctrl + Shift + L con BAEL enfocado" />
        </WrapPanel>
        <Border x:Name="ActivityBadge" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Top" Margin="30,2,30,0" Background="#F2FAF7FF" BorderBrush="#B8A4DE" BorderThickness="1" CornerRadius="12" Padding="8,5">
            <TextBlock x:Name="ActivityBadgeText" TextAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#574077" />
        </Border>
    </Grid>
    </Viewbox>
        <Popup x:Name="AnswerBubble" PlacementTarget="{Binding ElementName=Character}" Placement="Top"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Border Background="#FCFAFF" CornerRadius="18" BorderBrush="#C8B7EE" BorderThickness="1"
                    Width="250" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="BubbleMode" Foreground="#7460C8" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBlock x:Name="BubbleText" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis"
                               Foreground="#302847" LineHeight="19" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="Ver conversación" Click="ShowChat" HorizontalAlignment="Right"
                            Padding="9,5" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="ModeWheel" PlacementTarget="{Binding ElementName=Character}" Placement="Center"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Canvas x:Name="WheelCanvas" Width="440" Height="440" Background="{x:Null}"
                    PreviewKeyDown="WheelKey" />
        </Popup>
    </Grid>
</Window>
